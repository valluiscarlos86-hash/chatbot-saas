# Backend (NestJS) — copiar a apps/api/.env y completar.
# Nunca subir el archivo .env con valores reales: está en .gitignore.

# --- Obligatorias ---

# PostgreSQL con la extensión pgvector. El valor de abajo corresponde al
# contenedor de infrastructure/docker-compose.dev.yml.
DATABASE_URL=postgresql://chatbot:chatbot123@localhost:5432/chatbot_dev

# OpenAI: genera las respuestas (gpt-4o-mini) y los embeddings
# (text-embedding-3-small). Se obtiene en platform.openai.com.
OPENAI_API_KEY=sk-...

# Clerk: secreto para verificar la firma del webhook que crea la organización
# al registrarse un usuario. Se obtiene en el panel de Clerk, en Webhooks.
CLERK_WEBHOOK_SECRET=whsec_...

# --- Solo si se va a conectar WhatsApp ---

# Token que Meta envía en el handshake de verificación del webhook.
# Lo define el desarrollador: cualquier cadena, la misma de los dos lados.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Solo si se van a cargar URLs como base de conocimiento ---
FIRECRAWL_API_KEY=fc-...

# --- Solo si se va a conectar una tienda de Tiendanube ---
TIENDANUBE_APP_ID=
TIENDANUBE_CLIENT_SECRET=

# --- Opcional ---
PORT=3001
