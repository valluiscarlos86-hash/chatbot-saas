# Frontend (Next.js) — copiar a apps/web/.env.local y completar.
# Nunca subir el archivo .env.local con valores reales: está en .gitignore.

# --- Autenticación (Clerk) ---
# Ambas claves se obtienen en el panel de Clerk, en API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# --- Datos ---
# Misma base que usa el backend: los Server Components consultan directo.
DATABASE_URL=postgresql://chatbot:chatbot123@localhost:5432/chatbot_dev

# Dirección del backend NestJS.
BACKEND_URL=http://localhost:3001

# --- Opcional ---
# Número que el panel muestra como contacto de soporte.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
